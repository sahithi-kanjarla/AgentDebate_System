# Copy to .env (never commit .env). Leave a key empty to disable that provider.
DATABASE_URL=sqlite:///./tribunal.db

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

MISTRAL_API_KEY=

# --- Public demo protection (all optional; defaults leave everything open for local dev) ---
# RATE_LIMIT_ENABLED=true     # turn on for any public deployment (Space secrets / Dockerfile)
# RATE_LIMIT_PER_HOUR=5       # debates per IP per hour
# RATE_LIMIT_PER_DAY=20       # debates per IP per day
# GLOBAL_DAILY_CAP=15         # real debates per UTC day across all visitors; 0 = no cap
# MAX_CONCURRENT_DEBATES=0    # debates running at once; 0 = no cap
# TRUSTED_PROXY=0             # reverse proxies in front of the app; 0 = ignore X-Forwarded-For

# FOR LOCAL DEV ONLY. /api/agents then lists each persona's provider and model, which
# un-anonymizes every debate. Leave unset on any public deployment.
# EXPOSE_AGENT_MODELS=true
